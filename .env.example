APP_NAME=AI Agent Platform
VERSION=0.1.0
APP_ENV=development

# LLM provider: ollama | openai_compatible
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text

# OpenAI-compatible gateway (used when LLM_PROVIDER=openai_compatible), e.g. a
# self-hosted OmniRoute. Embeddings still go straight to Ollama.
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL_PREFIX=ollama/

# Vector DB (RAG)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Comma-separated API keys for /api/v1/* routes. Empty = auth disabled
# (local dev only -- set this before deploying anywhere reachable
# outside localhost).
API_KEYS=
SEARXNG_URL=http://localhost:8080

# Telegram bot for employees (docker compose service `telegram-bot`).
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot (@userinfobot).
TELEGRAM_ALLOWED_USER_IDS=
