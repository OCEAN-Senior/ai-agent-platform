APP_NAME=AI Agent Platform
VERSION=0.1.0
APP_ENV=development

# LLM provider: ollama | (future: openai, anthropic)
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text

# Vector DB (RAG)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Comma-separated API keys for /api/v1/* routes. Empty = auth disabled
# (local dev only -- set this before deploying anywhere reachable
# outside localhost).
API_KEYS=
SEARXNG_URL=http://localhost:8080
